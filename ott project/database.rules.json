{
  "rules": {
    "content": {
      ".read": true,
      ".write": false
    },
    "progress": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "notifications": {
      ".read": true,
      ".write": false
    },
    "announcements": {
      ".read": true,
      ".write": false
    }
  }
}
