rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — authenticated users read/write only their own document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Content catalogue — public read, no client writes
    match /content/{contentId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-user watch/listen progress
    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /items/{contentId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
